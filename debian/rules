#!/usr/bin/make -f
#export DH_VERBOSE = 1

export GOCACHE=$(shell mktemp -d /tmp/gocache-XXXX)
export GOFLAGS=-ldflags=-X=github.com/ubuntu/zsys/internal/config.Version=$(shell dpkg-parsechangelog -S Version) --mod=vendor
export DH_GOLANG_INSTALL_ALL=1

# Tell go generate to only install on-the-fly assets
export ZSYS_GENERATE_ONLY_INSTALL_SHARE_PREFIX=$(CURDIR)/debian/zsys-compat/usr/share

%:
	dh $@ --buildsystem=golang --with=golang,apport

override_dh_auto_clean:
	dh_auto_clean
	# create the vendor directory when building the source package
	[ -d vendor/ ] || go mod vendor

# Don't garbage collect snapshots while installing: GC destroys datasets, so it only runs from the timer
# after the next boot, or when asked with zsysctl service gc.
override_dh_installsystemd:
	dh_installsystemd --no-start zsys-gc.service zsys-gc.timer
	dh_installsystemd zsysd.socket zsysd.service zsys-commit.service

override_dh_auto_install:
	dh_auto_install -- --no-source
	# install in /sbin
	mv debian/zsys-compat/usr/bin/ debian/zsys-compat/sbin
	rmdir debian/zsys-compat/usr/
	# create zsysctl command
	ln -s zsysd debian/zsys-compat/sbin/zsysctl
	# run go generate for only installed generated assets
	# TODO this sometimes fails on ppc64le
	go generate $(GOFLAGS) ./...
	ls -latr debian/zsys-compat/usr/share/locale/de/LC_MESSAGES/
	ls -latr debian/zsys-compat/usr/share/locale/fr/LC_MESSAGES/
